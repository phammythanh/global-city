---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { formatPhone } from '../utils/format';

interface Props {
  phone: string;
  email: string;
  address?: string;
  zaloLink?: string;
  facebookLink?: string;
  youtubeLink?: string;
  websiteLink?: string;
}

const { phone, email, address, zaloLink, facebookLink, youtubeLink, websiteLink } = Astro.props;
const year = new Date().getFullYear();

const STROKE_ICONS = {
  phone: '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92Z"/>',
  mail: '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/>',
  mapPin: '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>',
  chevron: '<path d="m9 18 6-6-6-6"/>',
  message: '<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5Z"/>',
  globe: '<circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>',
};

function strokeIcon(name: keyof typeof STROKE_ICONS) {
  return `<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${STROKE_ICONS[name]}</svg>`;
}

const facebookIcon =
  '<svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3Z"/></svg>';

const youtubeIcon =
  '<svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.498 6.186a2.966 2.966 0 0 0-2.088-2.088C19.692 3.5 12 3.5 12 3.5s-7.692 0-9.41.598A2.966 2.966 0 0 0 .502 6.186 30.94 30.94 0 0 0 0 12a30.94 30.94 0 0 0 .502 5.814 2.966 2.966 0 0 0 2.088 2.088C4.308 20.5 12 20.5 12 20.5s7.692 0 9.41-.598a2.966 2.966 0 0 0 2.088-2.088A30.94 30.94 0 0 0 24 12a30.94 30.94 0 0 0-.502-5.814ZM9.75 15.02V8.98L15.5 12Z"/></svg>';
---

<footer class="site-footer">
  <div class="container grid">
    <div>
      <Image src={logo} alt="Global City" width={200} height={144} class="footer-logo" />
      <p class="text-muted">Thông tin dự án Global City.</p>
    </div>

    <div>
      <p class="col-title">Liên hệ</p>
      <p><a href={`tel:${phone}`}><Fragment set:html={strokeIcon('phone')} />{formatPhone(phone)}</a></p>
      <p><a href={`mailto:${email}`}><Fragment set:html={strokeIcon('mail')} />{email}</a></p>
      {address && (
        <p><Fragment set:html={strokeIcon('mapPin')} />{address}</p>
      )}
    </div>

    <div>
      <p class="col-title">Chuyên mục</p>
      <p><a href="/thap-tang"><Fragment set:html={strokeIcon('chevron')} />Thấp tầng</a></p>
      <p><a href="/cao-tang"><Fragment set:html={strokeIcon('chevron')} />Cao tầng</a></p>
      <p><a href="/tin-tuc"><Fragment set:html={strokeIcon('chevron')} />Tin tức</a></p>
    </div>

    <div>
      <p class="col-title">Kết nối</p>
      {zaloLink && (
        <p><a href={zaloLink} target="_blank" rel="noopener"><Fragment set:html={strokeIcon('message')} />Zalo</a></p>
      )}
      {facebookLink && (
        <p><a href={facebookLink} target="_blank" rel="noopener"><Fragment set:html={facebookIcon} />Facebook</a></p>
      )}
      {youtubeLink && (
        <p><a href={youtubeLink} target="_blank" rel="noopener"><Fragment set:html={youtubeIcon} />YouTube</a></p>
      )}
      {websiteLink && (
        <p><a href={websiteLink} target="_blank" rel="noopener"><Fragment set:html={strokeIcon('globe')} />batdongsansinhloi.com</a></p>
      )}
    </div>
  </div>

  <div class="container">
    <p class="copyright">© {year} Global City. Thông tin mang tính chất tham khảo.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-footer-bg);
    color: var(--color-on-dark);
    padding-block: 2.5rem 1.25rem;
  }

  .site-footer a {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    color: var(--color-on-dark);
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--color-primary);
  }

  /* :global because these <svg> icons are injected via set:html (raw
     strings), so they never receive Astro's scoped-style attribute. */
  :global(.icon) {
    flex: none;
    width: 16px;
    height: 16px;
  }

  .footer-logo {
    height: 64px;
    width: auto;
    margin-bottom: 0.75rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 2rem;
    padding-bottom: 2rem;
  }

  .text-muted {
    color: rgba(255, 255, 255, 0.7);
  }

  .col-title {
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 0.75rem;
  }

  .copyright {
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    padding-top: 1rem;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
  }
</style>
