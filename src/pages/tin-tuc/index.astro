---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('news', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout title="Tin tức" description="Tin tức và cập nhật mới nhất từ dự án Global City.">
  <section class="hero">
    <div class="container">
      <h1>Tin tức</h1>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {posts.length === 0 && <p>Chưa có bài viết nào.</p>}
      <div class="grid">
        {
          posts.map((post) => (
            <a class="card" href={`/tin-tuc/${post.id}`}>
              {post.data.cover && (
                <div class="card-image">
                  <Image
                    src={post.data.cover}
                    alt={post.data.cover_alt ?? post.data.title}
                    width={960}
                    height={600}
                  />
                </div>
              )}
              <div class="card-body">
                <p class="date">
                  {post.data.date.toLocaleDateString('vi-VN')}
                </p>
                <h2>{post.data.title}</h2>
                <p>{post.data.excerpt}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    background: var(--color-primary);
    color: #fff;
    padding-block: 3rem;
  }

  .hero h1 {
    color: #fff;
    margin: 0;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.75rem;
  }

  .card {
    display: block;
    background: var(--color-surface);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    color: var(--color-text);
    box-shadow: 0 8px 24px rgba(65, 54, 30, 0.08);
    transition: transform 0.15s ease;
  }

  .card:hover {
    transform: translateY(-3px);
  }

  /* Fixed 8:5 box, center-cropped so covers of any ratio still fill the
     card without stretching or changing the card's height. */
  .card-image {
    aspect-ratio: 8 / 5;
    overflow: hidden;
  }

  .card-image :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .card-body {
    padding: 1.25rem;
  }

  .card h2 {
    font-size: 1.15rem;
    margin: 0.25rem 0 0.5rem;
  }

  .date {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    margin: 0;
  }
</style>
