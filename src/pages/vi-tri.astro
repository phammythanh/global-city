---
import { getEntry, render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';

const entry = await getEntry('pages', 'vi-tri');
if (!entry) throw new Error('Missing content/pages/vi-tri.md');
const { Content } = await render(entry);
---

<PageLayout
  title={entry.data.title}
  description={entry.data.seo_description}
  heroImage={entry.data.hero_image}
  heroImageAlt={entry.data.hero_image_alt}
>
  {
    entry.data.intro_video && (
      <video class="intro-video" src={entry.data.intro_video} controls autoplay muted loop playsinline />
    )
  }
  <Content />
</PageLayout>

<style>
  .intro-video {
    display: block;
    width: 100%;
    max-width: 960px;
    aspect-ratio: 16 / 9;
    height: auto;
    margin: 0 auto 2rem;
    border-radius: var(--radius);
    background: #000;
    object-fit: cover;
  }
</style>
