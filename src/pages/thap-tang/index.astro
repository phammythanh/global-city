---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';

// Explicit order (not filesystem order) - matches the header dropdown.
const ORDER = ['soho', 'sola'];
const items = (await getCollection('thap-tang')).sort(
  (a, b) => ORDER.indexOf(a.id) - ORDER.indexOf(b.id)
);
---

<BaseLayout title="Thấp tầng" description="Các sản phẩm thấp tầng tại Global City: SOHO, SOLA.">
  <section class="hero">
    <div class="container">
      <h1>Thấp tầng</h1>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid">
        {
          items.map((item) => (
            <a class="card" href={`/thap-tang/${item.id}`}>
              {item.data.hero_image && (
                <div class="card-image">
                  <Image
                    src={item.data.hero_image}
                    alt={item.data.hero_image_alt ?? item.data.title}
                    width={960}
                    height={600}
                  />
                </div>
              )}
              <div class="card-body">
                <h2>{item.data.title}</h2>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    background: var(--color-primary);
    color: #fff;
    padding-block: 3rem;
  }

  .hero h1 {
    color: #fff;
    margin: 0;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.75rem;
  }

  .card {
    display: block;
    background: var(--color-surface);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    color: var(--color-text);
    box-shadow: 0 8px 24px rgba(65, 54, 30, 0.08);
    transition: transform 0.15s ease;
  }

  .card:hover {
    transform: translateY(-3px);
  }

  .card-image {
    aspect-ratio: 8 / 5;
    overflow: hidden;
  }

  .card-image :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .card-body {
    padding: 1.5rem;
  }

  .card h2 {
    margin: 0;
  }
</style>
