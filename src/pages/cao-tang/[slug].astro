---
import { getCollection, render } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import FloorPlanGallery from '../../components/FloorPlanGallery.astro';
import LeadForm from '../../components/LeadForm.astro';

export async function getStaticPaths() {
  const items = await getCollection('cao-tang');
  return items.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);
---

<PageLayout
  title={item.data.title}
  seoTitle={item.data.seo_title}
  description={item.data.seo_description}
  heroImage={item.data.hero_image}
  heroImageAlt={item.data.hero_image_alt}
>
  {
    item.data.intro_video && (
      <video class="intro-video" src={item.data.intro_video} controls autoplay muted loop playsinline />
    )
  }
  <Content />

  {item.data.gallery && <FloorPlanGallery items={item.data.gallery} layout="stacked" />}

  {
    item.data.gallery_groups?.map((group) => (
      <div class="gallery-group">
        <h2>{group.label}</h2>
        <FloorPlanGallery items={group.items} layout={group.layout} />
      </div>
    ))
  }

  {
    item.data.price_table && (
      <>
        <h2>Giá tham khảo</h2>
        <table>
          <thead>
            <tr>
              <th>Loại hình</th>
              <th>Giá tham khảo</th>
            </tr>
          </thead>
          <tbody>
            {item.data.price_table.map((row) => (
              <tr>
                <td>{row.label}</td>
                <td>{row.price}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p>
          <em>Giá bán mang tính chất tham khảo, liên hệ hotline để được cập nhật bảng hàng và chính sách mới nhất.</em>
        </p>
      </>
    )
  }

  {
    item.data.sales_policy && (
      <>
        <h2>Chính sách bán hàng</h2>
        <ul>
          {item.data.sales_policy.map((line) => (
            <li>{line}</li>
          ))}
        </ul>
        <p>
          <em>Chính sách bán hàng áp dụng theo từng thời điểm mở bán và có thể thay đổi, liên hệ hotline để được cập nhật chính sách mới nhất.</em>
        </p>
      </>
    )
  }

  {
    item.data.lead_form_title && (
      <LeadForm title={item.data.lead_form_title} productType="Cao tầng" projectName={item.data.title} />
    )
  }
</PageLayout>

<style>
  .intro-video {
    display: block;
    width: 100%;
    max-width: 960px;
    aspect-ratio: 16 / 9;
    height: auto;
    margin: 0 auto 2rem;
    border-radius: var(--radius);
    background: #000;
    object-fit: cover;
  }

  /* The floor-plan gallery needs more than the 72ch prose measure meant
     for reading paragraphs, but should still sit centered with room to
     breathe on both sides rather than stretch edge-to-edge. */
  :global(.prose:has(.floorplan-gallery)) {
    max-width: 960px;
    margin-inline: auto;
  }

  .gallery-group {
    margin-top: 2.5rem;
  }
</style>
