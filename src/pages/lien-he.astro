---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
import { formatPhone } from '../utils/format';
import sohoShowroomImage from '../content/thap-tang/images/soho/banner.webp';

const entry = await getEntry('pages', 'lien-he');
if (!entry) throw new Error('Missing content/pages/lien-he.md');
const site = await getEntry('settings', 'site');
const { Content } = await render(entry);

const ICONS = {
  phone: '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92Z"/>',
  mail: '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/>',
  mapPin: '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>',
};

function icon(name: keyof typeof ICONS) {
  return `<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICONS[name]}</svg>`;
}
---

<BaseLayout title={entry.data.title} description={entry.data.seo_description}>
  <section class="hero">
    <div class="container">
      <h1>{entry.data.title}</h1>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="prose">
        <h2>Liên hệ tư vấn</h2>

        <div class="contact-row">
          <a href={`tel:${site?.data.phone}`}><Fragment set:html={icon('phone')} />{formatPhone(site?.data.phone ?? '')}</a>
          <a href={`mailto:${site?.data.email}`}><Fragment set:html={icon('mail')} />{site?.data.email}</a>
          {site?.data.address && (
            <span><Fragment set:html={icon('mapPin')} />{site.data.address}</span>
          )}
        </div>

        <Content />
      </div>

      <div class="grid">
        <div class="feature-image">
          {
            entry.data.hero_image && (
              <Image
                src={entry.data.hero_image}
                alt={entry.data.hero_image_alt ?? entry.data.title}
                width={800}
                height={1000}
              />
            )
          }
        </div>

        <form id="contact-form" novalidate>
          <h2>Đăng ký nhận tư vấn</h2>

          <div class="field">
            <label for="cf-name">Họ tên *</label>
            <input id="cf-name" name="name" type="text" required maxlength="100" autocomplete="name" />
          </div>

          <div class="field">
            <label for="cf-phone">Số điện thoại *</label>
            <input id="cf-phone" name="phone" type="tel" required autocomplete="tel" placeholder="0903 596 692" />
          </div>

          <div class="field">
            <label for="cf-product-type">Sản phẩm quan tâm *</label>
            <select id="cf-product-type" name="productType" required>
              <option value="">-- Chọn sản phẩm --</option>
              <option value="Thấp tầng">Thấp tầng</option>
              <option value="Cao tầng">Cao tầng</option>
            </select>
          </div>

          <div class="field">
            <label for="cf-message">Lời nhắn</label>
            <textarea id="cf-message" name="message" rows="4" maxlength="1000"></textarea>
          </div>

          <input
            type="text"
            name="website"
            class="hp"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
          />

          <button type="submit" class="btn btn-primary">Gửi</button>
          <p class="form-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>

  <section class="section soho-section">
    <div class="container">
      <h2>Tham quan nhà mẫu SOHO</h2>
      <div class="grid">
        <LeadForm title="Đăng ký tham quan nhà mẫu SOHO" productType="Thấp tầng" projectName="SOHO" />
        <div class="feature-image">
          <Image src={sohoShowroomImage} alt="Nhà mẫu SOHO - The Global City" width={800} height={1000} />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = form?.querySelector<HTMLElement>('.form-status');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status) return;

    const data = new FormData(form);
    const payload = {
      name: data.get('name'),
      phone: data.get('phone'),
      productType: data.get('productType'),
      message: data.get('message'),
      website: data.get('website'),
    };

    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    submitBtn && (submitBtn.disabled = true);
    status.textContent = 'Đang gửi...';
    status.className = 'form-status';

    try {
      const res = await fetch('/api/lien-he', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
      });

      if (!res.ok) throw new Error('request_failed');

      form.reset();
      status.textContent = 'Cảm ơn bạn! Chúng tôi sẽ liên hệ lại trong thời gian sớm nhất.';
      status.className = 'form-status success';
    } catch {
      status.textContent = 'Có lỗi xảy ra, vui lòng gọi trực tiếp hotline hoặc thử lại sau.';
      status.className = 'form-status error';
    } finally {
      submitBtn && (submitBtn.disabled = false);
    }
  });
</script>

<style>
  .hero {
    background: var(--color-primary);
    color: #fff;
    padding-block: 3rem;
  }

  .hero h1 {
    color: #fff;
    margin: 0;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    margin-top: 2rem;
  }

  .feature-image {
    border-radius: var(--radius);
    overflow: hidden;
  }

  .feature-image :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
  }

  #contact-form {
    background: var(--color-surface);
    border-radius: var(--radius);
    padding: 1.75rem;
    box-shadow: 0 8px 24px rgba(65, 54, 30, 0.08);
    /* No explicit height - the grid's default align-items:stretch makes
       this item's box match the row height (set by the taller image),
       which works reliably; height:100% does not, since percentage
       heights don't resolve against an auto-sized grid row. */
    overflow-y: auto;
  }

  #contact-form h2 {
    margin-top: 0;
  }

  .field {
    margin-bottom: 1.1rem;
  }

  .field label {
    display: block;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.9rem;
    margin-bottom: 0.4rem;
    color: var(--color-primary-dark);
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    padding: 0.7em 0.9em;
    border: 1px solid rgba(65, 54, 30, 0.25);
    border-radius: calc(var(--radius) - 4px);
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-text);
    background: #fff;
  }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
  }

  .field textarea {
    resize: vertical;
  }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .form-status {
    display: inline-block;
    margin: 0.75rem 0 0;
    font-size: 0.9rem;
  }

  .form-status.success {
    color: #3d6b3d;
  }

  .form-status.error {
    color: #a33b3b;
  }

  /* .contact-row's parent .prose is capped at 72ch, too narrow to fit
     phone + email + address on one line - widen it just for this row. */
  :global(.prose:has(.contact-row)) {
    max-width: 100%;
  }

  .contact-row {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    margin-top: 2.5rem;
    margin-bottom: 2rem;
    padding-top: 1.75rem;
    border-top: 1px solid rgba(65, 54, 30, 0.15);
  }

  /* The CTA line inviting visitors to leave their info / call - make it
     stand out rather than blend in as plain body text. */
  .prose :global(p) {
    display: inline-block;
    margin: 0;
    padding: 0.9em 1.25em;
    background: var(--color-surface);
    border-left: 4px solid var(--color-accent);
    border-radius: calc(var(--radius) - 4px);
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-primary-dark);
  }

  .contact-row a,
  .contact-row span {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--color-primary-dark);
    text-decoration: none;
  }

  .contact-row a:hover {
    color: var(--color-accent);
  }

  .contact-row :global(.icon) {
    flex: none;
    width: 20px;
    height: 20px;
    color: var(--color-accent);
  }

  @media (max-width: 780px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  .soho-section {
    background: var(--color-bg);
    border-top: 1px solid rgba(65, 54, 30, 0.1);
  }

  .soho-section h2 {
    text-align: center;
  }
</style>
