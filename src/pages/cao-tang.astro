---
import { getEntry, render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import FloorPlanGallery from '../components/FloorPlanGallery.astro';

const entry = await getEntry('pages', 'cao-tang');
if (!entry) throw new Error('Missing content/pages/cao-tang.md');
const { Content } = await render(entry);
---

<PageLayout
  title={entry.data.title}
  description={entry.data.seo_description}
  heroImage={entry.data.hero_image}
  heroImageAlt={entry.data.hero_image_alt}
>
  <Content />

  {
    entry.data.gallery_groups?.map((group) => (
      <div class="gallery-group">
        <h2>{group.label}</h2>
        <FloorPlanGallery items={group.items} />
      </div>
    ))
  }
</PageLayout>

<style>
  /* The floor-plan gallery needs more than the 72ch prose measure meant
     for reading paragraphs, but should still sit centered with room to
     breathe on both sides rather than stretch edge-to-edge. */
  :global(.prose:has(.floorplan-gallery)) {
    max-width: 960px;
    margin-inline: auto;
  }

  .gallery-group {
    margin-top: 2.5rem;
  }
</style>
