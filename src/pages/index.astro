---
import { getEntry, render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';

const entry = await getEntry('pages', 'tong-quan');
if (!entry) throw new Error('Missing content/pages/tong-quan.md');
const { Content } = await render(entry);
---

<PageLayout
  title={entry.data.title}
  seoTitle={entry.data.seo_title}
  description={entry.data.seo_description}
  heroImage={entry.data.hero_image}
  heroImageAlt={entry.data.hero_image_alt}
>
  <Content />

  {
    entry.data.intro_video && (
      <video
        class="overview-video"
        src={entry.data.intro_video}
        controls
        autoplay
        muted
        loop
        playsinline
        poster={entry.data.hero_image?.src}
      />
    )
  }
</PageLayout>

<style>
  .overview-video {
    display: block;
    width: 100%;
    max-width: 960px;
    aspect-ratio: 16 / 9;
    height: auto;
    margin: 2rem auto 0;
    border-radius: var(--radius);
    background: #000;
    object-fit: cover;
  }
</style>
