---
import { getEntry, render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';

const entry = await getEntry('pages', 'tong-quan');
if (!entry) throw new Error('Missing content/pages/tong-quan.md');
const { Content } = await render(entry);
---

<PageLayout
  title={entry.data.title}
  seoTitle={entry.data.seo_title}
  description={entry.data.seo_description}
  heroImage={entry.data.hero_image}
  heroImageAlt={entry.data.hero_image_alt}
>
  <div class="overview-video-wrap">
    <iframe
      class="overview-video"
      src="https://www.youtube-nocookie.com/embed/OZvaUtEhHs8"
      title="The Global City - Video giới thiệu"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen
      loading="lazy"
    />
  </div>

  <Content />
</PageLayout>

<style>
  .overview-video-wrap {
    max-width: 960px;
    margin: 0 auto 2rem;
  }

  .overview-video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    height: auto;
    border: none;
    border-radius: var(--radius);
    background: #000;
  }
</style>
