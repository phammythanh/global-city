---
import { getEntry, render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';

const entry = await getEntry('pages', 'tong-quan');
if (!entry) throw new Error('Missing content/pages/tong-quan.md');
const { Content } = await render(entry);
---

<PageLayout
  title={entry.data.title}
  seoTitle={entry.data.seo_title}
  description={entry.data.seo_description}
  heroImage={entry.data.hero_image}
  heroImageAlt={entry.data.hero_image_alt}
>
  <iframe
    class="video-embed"
    src="https://www.youtube-nocookie.com/embed/OZvaUtEhHs8"
    title="The Global City - Video giới thiệu"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
    allowfullscreen
    loading="lazy"
  />

  <Content />
</PageLayout>
